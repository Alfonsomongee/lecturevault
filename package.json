{
  "name": "lecturevault",
  "version": "0.1.0",
  "description": "Local-first academic recording assistant — Milestone 1: Metadata extraction and dashboard",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync": "tsx src/index.ts sync",
    "accept:manual": "tsx src/index.ts accept-manual",
    "inspect:player": "tsx src/index.ts inspect-player",
    "check:hardware": "tsx src/utils/hardware.ts",
    "capture:audio": "tsx src/index.ts capture-audio",
    "capture:and:transcribe": "tsx src/index.ts capture-and-transcribe",
    "transcribe:test": "tsx src/transcriber/transcribe-cli.ts",
    "serve": "tsx src/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true
}
